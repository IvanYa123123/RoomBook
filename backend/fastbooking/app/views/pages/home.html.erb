<section class="hero">
  <h1>Найдите идеальный отель на нужные даты</h1>
  <p>Посуточное бронирование номеров по всей России. Поиск по городу, датам и количеству гостей.</p>

  <%= form_with url: hotels_path, method: :get, class: "search-form", local: true do |f| %>
    <div class="field">
      <%= f.label :city, "Город" %>
      <%= f.text_field :city, placeholder: "Например, Севастополь", value: params[:city] %>
    </div>
    <div class="field">
      <%= f.label :check_in, "Дата заезда" %>
      <%= f.date_field :check_in, value: params[:check_in] %>
    </div>
    <div class="field">
      <%= f.label :check_out, "Дата выезда" %>
      <%= f.date_field :check_out, value: params[:check_out] %>
    </div>
    <div class="field">
      <%= f.label :guests, "Гостей" %>
      <%= f.number_field :guests, value: params[:guests] || 1, min: 1, max: 10 %>
    </div>
    <%= f.submit "Найти", class: "btn btn--primary" %>
  <% end %>
</section>

<div class="section-title">
  <h2>Популярные отели</h2>
  <%= link_to "Смотреть все →", hotels_path, class: "muted" %>
</div>

<% if @popular_hotels.any? %>
  <div class="grid grid--3">
    <% @popular_hotels.each do |hotel| %>
      <article class="card hotel-card">
        <%= link_to hotel_path(hotel) do %>
          <%= cover_image(hotel) %>
        <% end %>
        <div class="card__body" style="display:flex; flex-direction:column; flex:1;">
          <h3 class="hotel-card__title"><%= link_to hotel.name, hotel_path(hotel) %></h3>
          <p class="hotel-card__address"><%= hotel.city %>, <%= hotel.address %></p>
          <div class="hotel-card__meta">
            <%= rating_badge(hotel) %>
            <div class="hotel-card__price">
              <% if hotel.min_price %>
                от <%= money(hotel.min_price) %> <span>за ночь</span>
              <% else %>
                <span>Нет номеров</span>
              <% end %>
            </div>
          </div>
          <div style="margin-top:auto;">
            <%= link_to "Посмотреть номера", hotel_path(hotel), class: "btn btn--ghost btn--block" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <h3>Пока нет добавленных отелей</h3>
    <p>Как только владельцы разместят объекты, они появятся здесь.</p>
  </div>
<% end %>
