<!DOCTYPE html>
<html lang="ru">
  <head>
    <title>FastBooking — бронирование отелей</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div class="container navbar__inner">
        <%= link_to "FastBooking", root_path, class: "brand" %>

        <nav class="nav-links">
          <%= link_to "Отели", hotels_path %>

          <% if logged_in? %>
            <% if current_user.guest? %>
              <%= link_to "Мои бронирования", guest_bookings_path %>
            <% else %>
              <%= link_to "Мои отели", host_hotels_path %>
              <%= link_to "Заявки", host_bookings_path %>
            <% end %>

            <span class="user-chip"><%= current_user.first_name %></span>
            <%= button_to "Выйти", logout_path, method: :delete, class: "btn btn--ghost btn--small" %>
          <% else %>
            <%= link_to "Войти", login_path, class: "btn btn--ghost btn--small" %>
            <%= link_to "Регистрация", signup_path, class: "btn btn--primary btn--small" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if flash.any? %>
      <div class="container">
        <% flash.each do |type, message| %>
          <div class="flash <%= flash_class(type) %>"><%= message %></div>
        <% end %>
      </div>
    <% end %>

    <main class="container main">
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="container">
        FastBooking — сервис посуточного бронирования отелей и номеров · <%= Date.current.year %>
      </div>
    </footer>
  </body>
</html>
